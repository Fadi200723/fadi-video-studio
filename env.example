# Desktop app: enter these in the Settings card instead (saved to your user profile). For `npm start`, put them here.
GEMINI_API_KEY=        # Google AI Studio key: AI query generation (used first when set)
GEMINI_MODEL=          # optional, e.g. gemini-3.5-flash
ANTHROPIC_API_KEY=     # AI query generation / scene understanding (strongly recommended)
OPENAI_API_KEY=        # Speech-to-text (Whisper), max 25MB per file
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_API_KEY=      # the Unsplash "Access Key"
FLICKR_API_KEY=
# No key needed: NASA, Wikimedia Commons, Internet Archive, Openverse
ANTHROPIC_MODEL=claude-sonnet-5-5
